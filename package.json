{
  "name": "comic-factory-new",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 43123 --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --port 43123 --host 127.0.0.1",
    "cf:build": "vite build",
    "cf:deploy": "pnpm cf:build && wrangler deploy",
    "cf:typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply comic-factory-new --local",
    "db:migrate:remote": "wrangler d1 migrations apply comic-factory-new --remote",
    "test": "node --experimental-strip-types --test src/modules/comic/story.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-router": "^1.170.45",
