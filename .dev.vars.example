# Local secrets for `vite dev` / `wrangler dev`. Copy to `.dev.vars`.
# Do not put production secrets in wrangler.jsonc vars.
AUTH_SECRET=replace-with-a-long-random-string

# Optional. When unset, storyboarding and panel art use the built-in renderer.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# IMAGE_API_KEY=
# IMAGE_BASE_URL=https://api.openai.com/v1
# IMAGE_MODEL=gpt-image-1

# Optional. Checkout stays disabled until this is set. No custom domain is required.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
